# Stage 1: Build dependencies in a temporary container
FROM node:18-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci

# Stage 2: Prune build tools and compile the runtime container
FROM node:18-alpine
WORKDIR /app
COPY package*.json ./
RUN npm install --only=production
COPY --from=builder /app/node_modules ./node_modules
COPY . .

EXPOSE 5000
CMD ["npm", "start"]